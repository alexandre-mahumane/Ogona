NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://ogona:ogona@localhost:5432/ogona
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=900

# Pavulla SMS (https://api.ola.pavulla.com/v1/messages)
# Use the raw API key (no "Basic " prefix — dotenv cuts the value at the first space).
PAVULLA_API_KEY=
SMS_PROVIDER_ID=
PAVULLA_SMS_SENDER=

# Meta WhatsApp Cloud API (fallback se Vonage não estiver configurado)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=pt_PT
WHATSAPP_OTP_BUTTON=none

# Vonage Messages API — WhatsApp (sandbox: messages-sandbox.nexmo.com)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WHATSAPP_FROM=
VONAGE_MESSAGES_URL=https://messages-sandbox.nexmo.com/v1/messages
VONAGE_SMS_FROM=Ogona
VONAGE_SMS_URL=https://rest.nexmo.com/sms/json
